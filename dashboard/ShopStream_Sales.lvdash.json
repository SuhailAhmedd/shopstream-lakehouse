{
  "datasets": [
    {
      "name": "ds_daily_revenue",
      "displayName": "Daily revenue (gold_daily_revenue)",
      "queryLines": [
        "SELECT order_date, orders, units_sold, revenue\n",
        "FROM shopstream.core.gold_daily_revenue"
      ]
    },
    {
      "name": "ds_category_performance",
      "displayName": "Category performance (gold_category_performance)",
      "queryLines": [
        "SELECT category, orders, units_sold, revenue, gross_margin\n",
        "FROM shopstream.core.gold_category_performance"
      ]
    },
    {
      "name": "ds_customer_ltv",
      "displayName": "Customer lifetime value (gold_customer_ltv)",
      "queryLines": [
        "SELECT customer_id, name, country, signup_channel, lifetime_orders, lifetime_revenue\n",
        "FROM shopstream.core.gold_customer_ltv"
      ]
    },
    {
      "name": "ds_top_customers",
      "displayName": "Top 10 customers (gold_customer_ltv)",
      "queryLines": [
        "SELECT CONCAT(name, ' (', customer_id, ')') AS customer, country, lifetime_orders, lifetime_revenue\n",
        "FROM shopstream.core.gold_customer_ltv\n",
        "ORDER BY lifetime_revenue DESC\n",
        "LIMIT 10"
      ]
    }
  ],
  "pages": [
    {
      "name": "shopstream_sales",
      "displayName": "ShopStream Sales",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
